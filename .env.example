# All optional. `make warehouse` and `make verify` need none of these.
# Copy to .env and fill in what you have. .env is ignored by git.
NEARBLOCKS_API_KEY=       # nearblocks.io/apis
NEARBLOCKS_RPM=           # calls per minute your NearBlocks plan allows; default 5.7 (free tier is 6)
FASTNEAR_API_KEY=         # dashboard.fastnear.com
INTENTS_EXPLORER_JWT=     # partners.near-intents.org
DUNE_API_KEY=             # dune.com settings; needs a plan or active trial that includes API access
GITHUB_TOKEN=             # raises the GitHub API limit from 60 to 5,000 calls per hour
